
{
  "hosting": {
    "public": "hosting-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "run": {
          "serviceId": "scafu",
          "region": "asia-south1"
        },
        "source": "**"
      }
    ]
  }
}
